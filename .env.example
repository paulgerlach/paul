# Server-only ($env/dynamic/private)
# Local Supabase (bun run db:start); migrations against staging/prod take the direct connection (port 5432)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
MAKE_WEBHOOK_UNIFIED=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
AI_GATEWAY_API_KEY=
# Supabase Storage (the Zählercheck's uploads): the project's API URL and secret key
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=

# Public ($env/static/public)
PUBLIC_PRISMIC_ENVIRONMENT=
