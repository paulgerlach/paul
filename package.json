{
	"name": "hs-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "bun run test:unit -- --run && bun run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"slicemachine": "start-slicemachine"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@slicemachine/adapter-sveltekit": "^0.3.99",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"slice-machine-ui": "^2.21.6",
		"svelte": "^5.56.7",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@ai-sdk/svelte": "^5.0.127",
		"@fontsource-variable/exo-2": "^5.3.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@lucide/svelte": "^1.49.0",
		"@prismicio/client": "^7.22.1",
		"@prismicio/svelte": "^2.2.2",
		"ai": "^7.0.127",
		"drizzle-orm": "^0.45.3",
		"lottie-web": "^5.13.0",
		"postgres": "^3.4.9",
		"remark-gfm": "^4.0.1",
		"svelte-exmarkdown": "^5.0.2",
		"svelte-sonner": "^1.2.1",
		"sveltekit-superforms": "^2.31.0",
		"swiper": "11.2.10",
		"zod": "^4.6.5"
	}
}
